rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPdfDocument(data, userId, pdfId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'url', 'storagePath',
          'sourceType', 'pageCount', 'sizeBytes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'url', 'storagePath',
          'sourceType', 'pageCount', 'sizeBytes', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == pdfId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.url is string && data.url.size() >= 8 && data.url.size() <= 2048
        && data.url.matches('^https://.*')
        && data.storagePath is string && data.storagePath.size() >= 10 && data.storagePath.size() <= 512
        && data.storagePath.matches('^users/' + userId + '/pdfs/.*')
        && data.sourceType is string && data.sourceType in ['images', 'text']
        && data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 500
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 26214400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private PII user profile isolated to owning user
    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      allow list: if isOwner(userId) && isValidId(userId) && existing().uid == request.auth.uid;
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && docId == 'profile'
        && isValidUserPrivateProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
    }

    // User-owned PDF metadata collection: users/{uid}/pdfs/{pdfId}
    match /users/{userId}/pdfs/{pdfId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(pdfId);
      allow list: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(pdfId)
        && isValidPdfDocument(incoming(), userId, pdfId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(pdfId)
        && isValidPdfDocument(incoming(), userId, pdfId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().url == existing().url
        && incoming().storagePath == existing().storagePath
        && incoming().sourceType == existing().sourceType
        && incoming().pageCount == existing().pageCount
        && incoming().sizeBytes == existing().sizeBytes
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(pdfId);
    }
  }
}
